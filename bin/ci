#!/usr/bin/env bash

set -uo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."

failures=()

step() {
  local name="$1"
  shift

  printf '\n\033[1m==> %s\033[0m\n' "$name"
  if "$@"; then
    printf '\033[32m--- %s passed\033[0m\n' "$name"
  else
    printf '\033[31m--- %s failed\033[0m\n' "$name"
    failures+=("$name")
  fi
}

step "RuboCop"       bundle exec rake rubocop
step "Steep"         bundle exec steep check
step "YARD coverage" bundle exec rake yard_coverage
step "Tests"         env COVERAGE=true bundle exec rake test

printf '\n'
if [ ${#failures[@]} -eq 0 ]; then
  printf '\033[32mAll checks passed.\033[0m\n'
else
  printf '\033[31mFailed: %s\033[0m\n' "${failures[*]}"
  exit 1
fi