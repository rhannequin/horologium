module Horologium
  VERSION: String

  CONFIGURATION_LOCK: Thread::Mutex

  def self.configure: () ?{ (Configuration config) -> void } -> Configuration

  def self.configuration: () -> Configuration

  def self.default_precision: () -> Symbol

  def self.current_precision: () -> Symbol

  def self.with_precision: [T] (Symbol precision) { () -> T } -> T

  def self.reset_configuration!: () -> void

  class Error < StandardError
  end

  class ConfigurationError < Error
  end

  class DimensionalError < Error
  end

  class ParseError < Error
  end

  class UnknownPrecisionError < Error
    attr_reader known_precisions: Array[Symbol]

    def initialize: (untyped precision, Array[Symbol] known_precisions) -> void
  end

  class InvalidCivilTimeError < Error
  end

  class OutOfRangeError < Error
  end

  class OutOfDataRangeError < Error
  end

  class UnknownScaleError < Error
    attr_reader known_scales: Array[Symbol]

    def initialize: (untyped scale, Array[Symbol] known_scales) -> void
  end

  class UnknownRepresentationError < Error
    attr_reader known_representations: Array[Symbol]

    def initialize: (untyped representation, Array[Symbol] known_representations) -> void
  end

  class UnknownOutputError < Error
    attr_reader known_outputs: Array[Symbol]

    def initialize: (untyped output, Array[Symbol] known_outputs) -> void
  end
end
