module Horologium
  class Duration
    include PreciseValue

    SECONDS_PER_DAY: Integer

    NANOSECONDS_PER_SECOND: Integer

    def self.seconds: (Numeric::scalar count, ?precision: Symbol) -> Duration

    def self.days: (Numeric::scalar count, ?precision: Symbol) -> Duration

    def self.nanoseconds: (Numeric::scalar count, ?precision: Symbol) -> Duration

    private def self.from_seconds: (Numeric::scalar seconds, Symbol precision) -> Duration

    def +: (Duration other) -> Duration

    def -: (Duration other) -> Duration

    def -@: () -> Duration

    def abs: () -> Duration

    def zero?: () -> bool

    def negative?: () -> bool

    def positive?: () -> bool

    def to_r: () -> Rational

    def to_f: () -> Float

    def inspect: () -> String
  end
end
