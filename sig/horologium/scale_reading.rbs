module Horologium
  class ScaleReading
    REPRESENTATIONS: Hash[Symbol, singleton(Representations::JulianDate) | singleton(Representations::ModifiedJulianDate) | singleton(Representations::Civil) | singleton(Representations::Iso8601)]

    @scale: Symbol

    @value: Numeric::TwoPartFloat | Numeric::Exact

    @precision: Symbol

    @time_scale: singleton(Scales::Base)

    attr_reader scale: Symbol

    attr_reader precision: Symbol

    attr_reader value: Numeric::TwoPartFloat | Numeric::Exact

    attr_reader time_scale: singleton(Scales::Base)

    def provenance: () -> Symbol

    def initialize: (Symbol scale, Numeric::TwoPartFloat | Numeric::Exact value, Symbol precision, singleton(Scales::Base) time_scale) -> void

    def as: (Symbol representation, ?as: Symbol) -> untyped

    def ==: (untyped other) -> bool

    def eql?: (untyped other) -> bool

    def hash: () -> Integer

    def inspect: () -> String
  end
end
