module Horologium
  module Scales
    class UTC < Base
      FIRST_DAY: Integer

      HALF: Rational

      MAX_STEPS: Integer

      def self.from_reference: (Numeric::TwoPartFloat | Numeric::Exact value, Symbol precision) -> (Numeric::TwoPartFloat | Numeric::Exact)

      def self.to_reference: (Numeric::TwoPartFloat | Numeric::Exact value, Symbol precision) -> (Numeric::TwoPartFloat | Numeric::Exact)

      def self.seconds_in_day: (Integer day_number) -> Integer

      def self.si_seconds_in_day: (Integer day_number) -> (Integer | Rational)

      def self.zone_designator: () -> String

      def self.provenance: (Numeric::TwoPartFloat | Numeric::Exact value) -> Symbol

      private def self.enforce_horizon: (Integer day_number) -> void

      private def self.past_horizon?: (Integer day_number) -> bool

      private def self.horizon_date: () -> Date?

      private def self.strict?: () -> bool

      private def self.whole_leap_seconds: (Integer day_number) -> Integer

      private def self.day_fraction: (Numeric::TwoPartFloat | Numeric::Exact value, Integer day, Symbol precision) -> (Numeric::TwoPartFloat | Numeric::Exact)

      private def self.unstretch: (Numeric::TwoPartFloat | Numeric::Exact value, Integer day, Symbol precision) -> (Numeric::TwoPartFloat | Numeric::Exact)

      private def self.before_midnight?: (Numeric::TwoPartFloat | Numeric::Exact value, Integer day, Symbol precision) -> bool

      private def self.midnight_tai: (Integer day, Symbol precision) -> (Numeric::TwoPartFloat | Numeric::Exact)

      private def self.day_scale: (Integer day, Integer | Rational dat0) -> Rational

      private def self.drift_rate: (Integer day, Integer | Rational dat0) -> Rational

      private def self.tai_utc_at: (Integer | Rational day_number) -> (Integer | Rational)

      private def self.refuse: () -> bot
    end
  end
end
