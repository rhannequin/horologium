module Horologium
  class Configuration
    BUILT_IN_SCALES: Hash[Symbol, singleton(Scales::Base)]

    @default_precision: Symbol

    @scales: Hash[Symbol, singleton(Scales::Base)]

    @leap_second_source: untyped

    attr_reader default_precision: Symbol

    attr_reader leap_second_source: untyped

    def initialize: () -> void

    def scale_names: () -> Array[Symbol]

    def default_precision=: (Symbol precision) -> Symbol

    def leap_second_source=: (untyped source) -> untyped

    def register_scale: (Symbol name, singleton(Scales::Base) scale) -> singleton(Scales::Base)

    def scale: (Symbol name) -> singleton(Scales::Base)

    def freeze: () -> self

    private

    def validate_scale!: (untyped scale) -> void
  end
end
