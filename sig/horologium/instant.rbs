module Horologium
  class Instant
    include PreciseValue

    def self.from_tai_julian_date: (Float high, ?Float low, ?precision: Symbol) -> Instant

    def +: (Duration duration) -> Instant

    def -: (Duration) -> Instant
         | (Instant) -> Duration

    def to: (Symbol scale) -> ScaleReading

    def as: (Symbol representation, scale: Symbol, ?as: Symbol) -> untyped

    def equal_within?: (Instant other, Duration tolerance) -> bool

    private

    def seconds_to_days: (Duration duration, Symbol precision) -> (Numeric::TwoPartFloat | Numeric::Exact)
  end
end
